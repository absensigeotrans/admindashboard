# -----------------------------------------------------------------------------
# GeoAttend Pro - Environment Variables Example
# Copy this file to .env.local for local development, or add these variables
# directly into your hosting provider's dashboard (e.g. Vercel Project Settings).
# -----------------------------------------------------------------------------

# Supabase Public API Keys (Accessed in Next.js Client and Server Components)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Private Service Role Key (Keep this secret! Only used on the server)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Database URL (Required for migrations / backend direct database access)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
